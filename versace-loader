function load_from_github(url, script_name)
    if loading_states[script_name] then
        return
    end

    if not trusted_script_hashes[script_name] then
        client.color_log(255, 0, 0, "[versace] Refusing unpinned script: " .. tostring(script_name))
        new_notify("Script has no trusted SHA-256 pin")
        return
    end
    
    loading_states[script_name] = true
    
    var_0_2.get(url, function(success, response)
        loading_states[script_name] = false
        
        if success and response and response.body and not response.body:find("404: Not Found") then
            if #response.body < 100 then
                client.color_log(255, 0, 0, "[versace] Script too short, possible error")
                return
            end
            
            
            local exec_success = execute_code(response.body, trusted_script_hashes[script_name])
            if exec_success then
                script_statuses[script_name] = true
                update_script_list()
                new_notify(script_display_names[script_name] .. " loaded!")
            else
                client.color_log(255, 100, 0, "[versace] Failed to execute " .. script_name)
                new_notify("Failed to load " .. script_display_names[script_name])
            end
        else
            local status = response and response.status or "unknown"
            client.color_log(255, 0, 0, "[versace] Download failed. Status: " .. status)
            new_notify("Download failed for " .. script_display_names[script_name])
        end
    end)
end

