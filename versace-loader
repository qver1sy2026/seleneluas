-- Supabase Edge Function auth (Varg-inspired request envelope).
function check_access()
    local username = ui.get(username_input)
    local hwid = tostring(ui.get(hwid_input) or "")
    if username == "" or hwid == "" then
        new_notify("Please enter username and HWID")
        ui.set(status_label, "Status: Enter credentials")
        return
    end
    if SUPABASE_URL:find("YOUR_PROJECT_REF", 1, true)
        or SUPABASE_PUBLISHABLE_KEY:find("YOUR_SUPABASE_PUBLISHABLE_KEY", 1, true) then
        client.color_log(255, 0, 0, "[versace] Supabase URL/key not configured")
        ui.set(status_label, "Status: Configure Supabase")
        return
    end
    ui.set(status_label, "Status: Checking access...")
    local request_data = {
        type = "AUTHENTICATE", username = username, hwid = hwid,
        timestamp = client.unix_time() * 1000,
        payload = { version = SUPABASE_CLIENT_VERSION }
    }
    local ok, encoded = pcall(var_0_3.stringify, request_data)
    if not ok or type(encoded) ~= "string" then
        client.color_log(255, 0, 0, "[versace] Failed to encode auth request")
        ui.set(status_label, "Status: Request error")
        return
    end
    var_0_2.post(SUPABASE_AUTH_URL, {
        headers = {
            ["apikey"] = SUPABASE_PUBLISHABLE_KEY,
            ["Content-Type"] = "application/x-www-form-urlencoded"
        },
        params = { data = encoded }
    }, function(success, response)
        if not success or not response or not response.body then
            client.color_log(255, 0, 0, "[versace] Supabase connection failed")
            ui.set(status_label, "Status: Connection error")
            return
        end
        local parsed_ok, result = pcall(var_0_3.parse, response.body)
        if not parsed_ok or type(result) ~= "table" then
            client.color_log(255, 0, 0, "[versace] Invalid auth response")
            ui.set(status_label, "Status: Invalid server response")
            return
        end
        if result.type ~= "AUTHENTICATED" then
            local error_payload = type(result.payload) == "table" and result.payload or {}
            client.color_log(255, 0, 0, "[versace] Authentication failed: " ..
                tostring(error_payload.message or result.message or "Access denied"))
            ui.set(status_label, "Status: Access denied")
            var_0_54 = false
            _G.loader.logged_in, _G.loader.user, _G.loader.access = false, "", {}
            _G._user_name = ""
            user_access, script_statuses = {}, {}
            database.write("versace_session_token", nil)
            database.write("versace_session_expiry", nil)
            database.write("versace_access", nil)
            update_script_list()
            update_ui_visibility()
            return
        end

        -- Supabase varg-auth response nests session fields under payload.user.
        local auth_payload = type(result.payload) == "table" and result.payload or nil
        local auth_user = auth_payload and type(auth_payload.user) == "table"
            and auth_payload.user or nil
        local session_token = auth_payload and auth_payload.token or nil
        local granted_scripts = auth_user and auth_user.scripts or nil
        local authenticated_username = auth_user and auth_user.username or username
        local session_expiry = auth_payload and auth_payload.expires_at or nil

        if type(granted_scripts) ~= "table" or type(session_token) ~= "string"
            or session_token == "" then
            client.color_log(255, 0, 0, "[versace] Auth response missing session data")
            ui.set(status_label, "Status: Invalid server response")
            return
        end
        user_access, script_statuses = {}, {}
        for _, name in ipairs(granted_scripts) do
            if type(name) == "string" and script_display_names[name] then
                user_access[name], script_statuses[name] = true, false
            end
        end
        if next(user_access) == nil then
            client.color_log(255, 0, 0, "[versace] Account has no script permissions")
            ui.set(status_label, "Status: No scripts assigned")
            return
        end
        var_0_54 = true
        _G.loader.logged_in, _G.loader.user, _G.loader.access = true, authenticated_username, user_access
        _G._user_name = authenticated_username
        database.write("versace_username", authenticated_username)
        database.write("versace_hwid", hwid)
        database.write("versace_session_token", session_token)
        database.write("versace_session_expiry", session_expiry)
        database.write("versace_access", nil)
        local count = 0
        for _ in pairs(user_access) do count = count + 1 end
        new_notify("Access granted! Welcome " .. authenticated_username)
        client.color_log(0, 255, 0, "[versace] Access granted! Welcome " .. authenticated_username)
        ui.set(status_label, "Status: Logged in - " .. count .. " scripts")
        update_script_list()
        update_ui_visibility()
    end)
end

function update_script_list()
    formatted_scripts = {}
    available_scripts = {}
    
    if not _G.loader.logged_in then
        ui.update(script_list, {"Login to see scripts"})
        return
    end
    
    for script_name, has_access in pairs(user_access) do
        if script_display_names[script_name] then
            local status_icon = script_statuses[script_name] and "\a".. menu_c_hex .."✓" or "\a".. menu_c_hex .."○"
            local display_name = script_display_names[script_name]
            table.insert(formatted_scripts, status_icon .. "\abfbdbdFF " .. display_name .. " ")
            table.insert(available_scripts, script_name)
        end
    end
    
    if #formatted_scripts == 0 then
        formatted_scripts = {"No scripts available"}
        available_scripts = {}
    end
    
    ui.update(script_list, formatted_scripts)
end

function load_selected_script(script_name)
    if not user_access[script_name] then
        new_notify("No access to " .. script_display_names[script_name])
        return
    end
    
    local github_url = script_urls[script_name]
    if github_url then
        new_notify("Loading " .. script_display_names[script_name] .. "...")
        load_from_github(github_url, script_name)
    else
        new_notify("Invalid script: " .. script_name)
        client.color_log(255, 0, 0, "[versace] Invalid script URL: " .. script_name)
    end
end

function unload_selected_script(script_name)
    new_notify("Unloading " .. script_display_names[script_name])
    client.reload_active_scripts()
    script_statuses[script_name] = false
    update_script_list()
end

